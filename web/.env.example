# Required: 32+ characters, signs the bugrail_session cookie.
SESSION_PASSWORD=
# Optional. The Gemini key can also be set by an admin (stored in server.db secrets).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TESTFORGE_ENABLED=0
# Set to 1 only behind a reverse proxy that overwrites x-forwarded-for; login rate limit then keys on it.
BUGRAIL_TRUSTED_PROXY=0
BUGRAIL_DB_PATH=/var/lib/bugrail/server.db
# Optional. Rewind (/rewind) syncs its local database to this Turso Cloud database; unset keeps it local-only.
REWIND_TURSO_DATABASE_URL=
REWIND_TURSO_AUTH_TOKEN=
# Set to use a remote Turso database instead of BUGRAIL_DB_PATH (e.g. on Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional HTTP Basic Auth in front of the whole app; off unless both are set.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Used once by scripts/bootstrap-turso.ts to create the first admin on an empty database.
BUGRAIL_ADMIN_EMAIL=
BUGRAIL_ADMIN_PASSWORD=
