# Copy to /etc/bugrail/bugrail.env, chmod 600, owner root. Never commit the real file.
SESSION_PASSWORD=change-me-to-32-or-more-random-characters
BUGRAIL_DB_PATH=/var/lib/bugrail/server.db
# Set only when a reverse proxy in front of the app sets X-Forwarded-For (read by the login rate limit).
# BUGRAIL_TRUSTED_PROXY=1
# TestForge (optional): the route answers a disabled message unless both are set.
# TESTFORGE_ENABLED=1
# GEMINI_API_KEY=
# GEMINI_MODEL=
# NEVER set BUGRAIL_DEV_AUTH here: it turns on dev users and the x-dev-user header.
